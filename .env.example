# Copy to .env and fill in. Never commit secrets.

# Hugging Face (required to push datasets / pull gated models)
HF_TOKEN=
# Optional: used by some LeRobot scripts
HUGGING_FACE_HUB_TOKEN=

# Weights & Biases (optional training logs)
WANDB_API_KEY=
WANDB_PROJECT=pizza-robo-hack
WANDB_ENTITY=

# Nebius Object Storage (cloud training checkpoints)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north1
S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
S3_BUCKET=
S3_PREFIX=pizza-robo-hack
# Resource id (storagebucket-...), not the bucket name — needed for volume mounts
BUCKET_ID=

# Optional Nebius job overrides
SUBNET_ID=
HF_USER=
