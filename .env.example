# Copy to .env and fill in. Never commit secrets.

# Hugging Face (your user or org — not the organizer account)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
HF_USER=
DATASET_NAME=robot-pizza-cup-1
# Full Hub repo for training (defaults in scripts: $HF_USER/$DATASET_NAME if unset)
DATASET_REPO_ID=robotpizzacup/robot-pizza-cup-1
# Hub tag/branch (set this for cloud jobs if the dataset uses tags)
DATASET_REVISION=

# Weights & Biases — use your entity; join the shared project if you want the team board
WANDB_API_KEY=
WANDB_PROJECT=robotpizzacup
WANDB_ENTITY=

# Nebius shared POSIX filesystem (checkpoints). Not an S3 bucket id.
FILESYSTEM_ID=
CHECKPOINT_MOUNT=/mnt/checkpoints
# Local mount of that filesystem (Mac/jump host) for download_checkpoint.sh
CHECKPOINT_FS_ROOT=

# Optional: also push the policy to the Hub so rollout does not need the FS
# POLICY_PUSH_TO_HUB=true
# POLICY_REPO_ID=                    # default: $HF_USER/pizza-<policy>

# Organizer defaults — override if you use your own Nebius project
PARENT_ID=project-e00qfhq9pr00hmgrkch9z4
SUBNET_ID=
IMAGE=mnrozhkov/pizza-robo-hack:latest
DEPS_IMAGE=mnrozhkov/pizza-robo-hack:deps
# Default GPU is RTX PRO 6000. Preset must match the platform.
# JOB_PLATFORM=gpu-rtx6000-a
# JOB_PRESET=1gpu-24vcpu-218gb
# us-central1 uses JOB_PLATFORM=gpu-rtx6000 with the same preset.
# L40S (eu-north1): gpu-l40s-a + 1gpu-24vcpu-96gb
# H100 (eu-north1): gpu-h100-sxm + 1gpu-16vcpu-200gb
