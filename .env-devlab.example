# DevLab only. From the repo root, in a JupyterLab terminal (not the file browser):
#   cp .env-devlab.example .env
# Fill the tokens below. The file on the DevLab must be named .env.
# Never commit .env. Jupyter cannot save a file at /.env.

# Hugging Face read token. Skip both if you already ran: uv run hf auth login
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Weights & Biases. WANDB_API_KEY is required while the policy YAML has wandb.enable: true.
WANDB_API_KEY=
WANDB_PROJECT=robotpizzacup
WANDB_ENTITY=

# Shared pizza dataset. lerobot-train does not read this variable;
# the DevLab commands pass robotpizzacup/robot-pizza-cup-1 on the CLI.
DATASET_REPO_ID=robotpizzacup/robot-pizza-cup-1
